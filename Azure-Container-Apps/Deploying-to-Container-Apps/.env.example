# Local configuration for the sample API.
#
# Copy this file to ".env" and run the app locally with:
#   uvicorn app:app --env-file .env
#
# On Azure Container Apps these same values arrive as environment variables and
# secrets supplied by the host, not from this file — that is the whole point of
# the lab. APP_GREETING is a plain setting; APP_REGION stands in for a value you
# would keep as a Container Apps secret.

APP_GREETING=Hello from a container
APP_REGION=local
